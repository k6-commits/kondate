# きめとく（仮）プロトタイプのサーバー（npm run server）の設定の例。
# このファイルを .env にコピーして値を入れてください。サーバーは起動時に .env を読み込みます
# （すでに設定されている環境変数は上書きしません）。
# .env にはシークレットが入るので、git に入れないでください。

# --- LINE（Messaging API のチャネル。LINE Developers コンソールで確認） ---
# コンソールでは次のように設定します。
#   Webhook URL：https://<このサーバーの公開URL>/line/webhook（「Webhook の利用」をオン）
#   応答メッセージ（自動応答）：オフ ／ グループ・複数人トークへの参加を許可：オン
# チャネルシークレット。webhook の署名（x-line-signature）の検証に使います。
# 未設定なら POST /line/webhook は 503 を返します。
LINE_CHANNEL_SECRET=
# チャネルアクセストークン（長期）。返信（reply）と配信（push）に使います。
# 未設定なら、webhook は受け取って保存しますが、返信はしません。
LINE_CHANNEL_ACCESS_TOKEN=

# --- LLM（任意） ---
# 設定したときだけ、書き込みの解釈に LLM（Claude）を使います。
# 未設定、または失敗したとき（1回の解釈は12秒まで）は、ルールベースで解釈します。
ANTHROPIC_API_KEY=
# 使うモデル（任意）。既定は claude-opus-5-5。
KIMETOKU_MODEL=

# --- 夕方の配信 ---
# POST /cron/evening を呼ぶための共有シークレット（Authorization: Bearer <CRON_SECRET>）。
# 長いランダムな文字列にしてください（例：openssl rand -hex 32）。
# 未設定なら POST /cron/evening は 503 を返します。
# 例：毎日（土日も）夕方（日本時間 17:00 ごろ）に、外部の cron から次のように呼びます。
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://<このサーバーの公開URL>/cron/evening
# 来週の献立は「最初の買い物日の前日」（土日のこともある）にできて、その日の夕方に配信します。
# 平日だけ呼ぶと、週末にできた献立は月曜の配信になります。
CRON_SECRET=

# --- 保存と待ち受け ---
# 送り元（LINE のユーザー・グループ）ごとの状態を JSON で保存するディレクトリ。既定は .data。
# 保存するのは献立・在庫・記録と LINE の ID で、発言の原文は保存しません。ブロック・グループからの退出で消します。
DATA_DIR=.data
# 待ち受けるポート。既定は 8787。
PORT=8787
# 待ち受けるアドレス（任意）。未設定なら、すべてのアドレスで待ち受けます（LINE の webhook を受けるため）。
# ただし PARSE_API_ENABLED を有効にしたときは、未設定なら 127.0.0.1（このマシンからだけ）になります。
# 手元だけで試すときは 127.0.0.1 にしてください。
HOST=

# --- 開発用：画面からの AI の読み取り（POST /api/parse） ---
# 1 にすると、画面（npm run dev）が VITE_PARSE_API で呼ぶ POST /api/parse が使えます。既定は無効（404）。
# この口には認証がなく、ANTHROPIC_API_KEY があれば呼ばれるたびに LLM の費用がかかります。
# 手元の開発だけで使い、公開するサーバー（LINE の webhook を受けるもの）では有効にしないでください。
PARSE_API_ENABLED=
# POST /api/parse を許可するオリジン。既定は http://localhost:5173。カンマ区切りで複数も指定できます。
# ほかのオリジンからのリクエストは 403、本文が JSON（application/json）でないものは 415 で断ります。
CORS_ORIGIN=http://localhost:5173
