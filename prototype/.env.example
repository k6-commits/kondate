# きめとく（仮）プロトタイプのサーバー（npm run server）の設定の例。
# このファイルを .env にコピーして値を入れてください。サーバーは起動時に .env を読み込みます
# （すでに設定されている環境変数は上書きしません）。
# .env にはシークレットが入るので、git に入れないでください。

# --- LINE（Messaging API のチャネル。LINE Developers コンソールで確認） ---
# コンソールでは次のように設定します。
#   Webhook URL：https://<このサーバーの公開URL>/line/webhook（「Webhook の利用」をオン）
#   応答メッセージ（自動応答）：オフ ／ グループ・複数人トークへの参加を許可：オン
# チャネルシークレット。webhook の署名（x-line-signature）の検証に使います。
# 未設定なら POST /line/webhook は 503 を返します。
LINE_CHANNEL_SECRET=
# チャネルアクセストークン（長期）。返信（reply）と配信（push）に使います。
# 未設定なら、webhook は受け取って保存しますが、返信はしません。
LINE_CHANNEL_ACCESS_TOKEN=

# --- LLM（任意） ---
# 設定したときだけ、書き込みの解釈に LLM（Claude）を使います。
# 未設定、または失敗したときは、ルールベースで解釈します。
ANTHROPIC_API_KEY=
# 使うモデル（任意）。既定は claude-opus-5-5。
KIMETOKU_MODEL=

# --- 夕方の配信 ---
# POST /cron/evening を呼ぶための共有シークレット（Authorization: Bearer <CRON_SECRET>）。
# 長いランダムな文字列にしてください（例：openssl rand -hex 32）。
# 未設定なら POST /cron/evening は 503 を返します。
# 例：平日の夕方（日本時間 17:00 ごろ）に、外部の cron から次のように呼びます。
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://<このサーバーの公開URL>/cron/evening
CRON_SECRET=

# --- 保存と待ち受け ---
# 送り元（LINE のユーザー・グループ）ごとの状態を JSON で保存するディレクトリ。既定は .data。
DATA_DIR=.data
# 待ち受けるポート。既定は 8787。
PORT=8787
# POST /api/parse（画面が開発時に使う）を許可するオリジン。既定は http://localhost:5173。
# カンマ区切りで複数も指定できます。
CORS_ORIGIN=http://localhost:5173
